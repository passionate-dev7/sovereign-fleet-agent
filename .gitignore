__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
*.log
demo_artifacts/

# Credentials. Nothing here should ever be committed: the deploy path uses
# Application Default Credentials and the job's own service account, so a
# key file in the tree means something went wrong.
.env
.env.*
*-key.json
*credentials*.json
service-account*.json
*.pem
*.p8

# Filming aid: break_validator.sh leaves this next to whatever it breaks.
# Committing one means a disabled validator shipped.
*.demo-break-backup
.vercel

# Submission-prep meta docs (kept local, not part of the shipped project)
SUBMISSION.md
DEMO_SCRIPT.md
DEVPOST_STORY.md
DEVPOST_STORY_DRAFT.md
RED_GREEN.md
LIMITATIONS.md
proof/devpost_story_live*.png
